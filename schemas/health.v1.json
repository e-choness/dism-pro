{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/e-choness/dism-pro/schemas/health.v1.json",
  "title": "dismpro-cli health check|scan --json",
  "type": "object",
  "properties": {
    "schema": {
      "const": "health.v1"
    },
    "state": {
      "enum": [
        "healthy",
        "repairable",
        "non-repairable"
      ]
    },
    "scanned": {
      "type": "boolean"
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "severity": {
            "enum": [
              "info",
              "warning",
              "error"
            ]
          },
          "diagnosis": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "code": {
            "oneOf": [
              {
                "type": "string",
                "pattern": "^0x[0-9a-f]{8}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "log": {
            "enum": [
              "cbs",
              "dism"
            ]
          },
          "first_line": {
            "type": "integer",
            "minimum": 1
          },
          "last_line": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "severity",
          "diagnosis",
          "message",
          "code",
          "log",
          "first_line",
          "last_line"
        ]
      }
    }
  },
  "required": [
    "schema",
    "state",
    "scanned",
    "findings"
  ]
}
