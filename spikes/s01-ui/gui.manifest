<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- The application manifest every S-01 exe embeds (bare, A and B alike, so startup and WinPE results
     compare like for like), as the real GUI will: Windows 10+ behaviour (without supportedOS,
     version queries answer Windows 8), per-monitor v2 DPI, and common controls v6. B's winit
     backend imports comctl32.dll, which base WinPE's System32 lacks (S-01 facts, run 41589907500);
     with this dependency the loader looks for it side by side instead.
     The build (manifest.rs) writes the target's architecture over processorArchitecture="*":
     Windows takes either, but Wine (T2) crashes in its activation-context code on "*". -->

<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <dependency>
    <dependentAssembly>
      <assemblyIdentity type="win32" name="Microsoft.Windows.Common-Controls" version="6.0.0.0"
                        processorArchitecture="*" publicKeyToken="6595b64144ccf1df" language="*"/>
    </dependentAssembly>
  </dependency>
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10, Windows 11, Windows Server 2016 and later -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}"/>
    </application>
  </compatibility>
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v3">
    <security>
      <requestedPrivileges>
        <requestedExecutionLevel level="asInvoker" uiAccess="false"/>
      </requestedPrivileges>
    </security>
  </trustInfo>
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <dpiAware xmlns="http://schemas.microsoft.com/SMI/2005/WindowsSettings">true/pm</dpiAware>
      <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">PerMonitorV2</dpiAwareness>
      <longPathAware xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">true</longPathAware>
    </windowsSettings>
  </application>
</assembly>
